# Environment for the neve service, installed as /etc/neve/neve.env.
#
# Tuning does NOT live here any more. It lives in /etc/neve/config.toml — the
# fully annotated reference is installed beside it as
# /etc/neve/config.toml.example (`neve --print-config-example` prints the same
# thing), and `neve --print-config` shows what this box actually resolved to.
# The unit runs:
#
#     /usr/local/bin/neve --config /etc/neve/config.toml $NEVE_ARGS
#
# This file is installed 0640 root:neve, because it can hold a secret; systemd
# reads it as root, before dropping to the service user.

# --- upstream token ----------------------------------------------------------
# The rate-limit bypass token neve appends to every upstream URL as
# `?token=…`. Commented out on purpose: in production prefer a token *file*,
# which keeps the secret out of the process environment entirely.
#
#     install -m 0640 -o root -g neve /dev/null /etc/neve/token
#     printf '%s' '<token>' >/etc/neve/token
#
# then point config.toml at it:
#
#     [upstream]
#     token_file = "/etc/neve/token"
#
# `token_file` wins when both are set. The file is preferred because an
# environment variable is inherited by everything the process spawns and is
# visible in /proc/<pid>/environ, while the file is read once at startup. A
# command-line flag would be worse still — /proc/<pid>/cmdline is world-readable
# to every local user — which is why there is no token flag at all. neve holds
# the value in a type whose Debug and Display both render `<redacted>`, so it
# cannot reach the journal by accident either way.
#NEVE_UPSTREAM_TOKEN=

# --- emergency overrides -----------------------------------------------------
# Extra arguments, whitespace-split by systemd and appended after --config, so
# they beat everything in the file. This is an escape hatch for a change you
# need *now* — say `--set chains.p.request_interval=0` while the node this box
# fills from is being swapped — not the configuration channel. Anything that
# should survive the next operator reading config.toml belongs in config.toml.
NEVE_ARGS=
