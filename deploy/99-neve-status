#!/usr/bin/env bash
# /etc/update-motd.d/99-neve-status   (numbered last so it renders below the
# stock system-information block, right above the shell prompt)
#
# Login MOTD fragment: probe the local neve `/health` endpoint and print a
# two-column status block in the style of Ubuntu's "System information".
# Reports up/down and, when up, port, uptime, network, disk, memory, and then
# **one row per running chain** with that chain's sync state and served range.
#
# One process can mirror several chains (a `[chains.<x>]` table each in
# /etc/neve/config.toml, and both are enabled by default), and the two are
# routinely in wildly different states — a fresh P-chain store is 25M heights
# behind while the C-chain sits at the tip. The top-level `/health` fields
# describe only the *default* chain, so reading them alone reported the C-chain's
# "caught up" and the C-chain's disk as if they were the whole box. Sync and
# range are therefore per-chain rows, and disk is summed across `chains`.
#
# Reads the bind address from /etc/neve/config.toml ([server] addr), then lets
# a --rpc-addr in /etc/neve/neve.env's $NEVE_ARGS override it — the same
# precedence neve itself applies, and what keeps this correct on a box not yet
# migrated off the flags. Falls back to neve's default. Override explicitly
# with NEVE_HEALTH_URL=http://host:port.
#
# The block is a point-in-time snapshot taken at login (the "as of" header
# makes the age explicit) — it is not refreshed while the session is open.
#
# Kept fast and quiet: a 2s curl timeout means a hung or missing neve never
# stalls a login. Degrades cleanly if curl or jq is absent.
set -u

# --- locate dependencies -----------------------------------------------------
CURL=$(command -v curl || true)
JQ=$(command -v jq || true)

# --- colors ------------------------------------------------------------------
# Emit the 16-color ANSI codes unconditionally. A MOTD fragment runs inside
# pam_motd's generation environment — no controlling tty, and TERM is typically
# unset or "dumb" — but its output is displayed *later* on the user's real
# login terminal. So no signal available here (`[ -t 1 ]`, $TERM, $NO_COLOR)
# reflects the terminal that will actually render this; gating on any of them
# strips color exactly where we want it (the earlier tty and TERM=dumb gates
# both made this mistake). A MOTD is by definition shown on an interactive
# login terminal, and every such terminal handles 16-color SGR — so just emit.
# NEVE_MOTD_NO_COLOR=1 forces plain output (handy for piping/testing).
if [ -n "${NEVE_MOTD_NO_COLOR:-}" ]; then
  RED=''; GRN=''; YEL=''; CYAN=''; BOLD=''; RST=''
else
  RED=$'\e[31m'; GRN=$'\e[32m'; YEL=$'\e[33m'; CYAN=$'\e[36m'; BOLD=$'\e[1m'; RST=$'\e[0m'
fi

NOW=$(date)

# Two columns per row. Each cell is "label: value"; the left cell is padded to
# a fixed width so the right labels line up, matching the system-info block.
# Colors are measured-out of the pad width so coloring never breaks alignment.
row() {
  local ll="$1" lv="$2" rl="$3" rv="$4" pad=26 vis plain
  plain=$(printf '%s' "$lv" | sed 's/\x1b\[[0-9;]*m//g')   # strip color for width
  vis=$(( pad - ${#ll} - 2 - ${#plain} ))     # 2 = ": "
  (( vis < 1 )) && vis=1
  printf '  %s: %s%*s%s: %s\n' "$ll" "$lv" "$vis" '' "$rl" "$rv"
}

# --- resolve the health URL + display host:port ------------------------------
HEALTH_URL="${NEVE_HEALTH_URL:-}"
addr=127.0.0.1:8545
if [ -z "$HEALTH_URL" ]; then
  # `addr` appears only under [server], so a keyed line match is enough TOML
  # parsing for this — no dependency on a toml reader in a MOTD fragment.
  if [ -r /etc/neve/config.toml ]; then
    a=$(sed -n 's/^[[:space:]]*addr[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
        /etc/neve/config.toml | tail -n1)
    [ -n "$a" ] && addr="$a"
  fi
  if [ -r /etc/neve/neve.env ]; then
    a=$(sed -n 's/.*--rpc-addr[ =]\([^ ]*\).*/\1/p' /etc/neve/neve.env | tail -n1)
    [ -n "$a" ] && addr="$a"
  fi
  probe=${addr/0.0.0.0:/127.0.0.1:}           # neve may bind 0.0.0.0; probe loopback
  probe=${probe/\[::\]:/127.0.0.1:}
  HEALTH_URL="http://${probe}/health"
fi
# Display the port the way an operator types it.
port="$addr"
case "$addr" in
  127.0.0.1:*|0.0.0.0:*|\[::\]:*|\[::1\]:*) port="localhost:${addr##*:}" ;;
esac

# No leading blank line of our own: the preceding MOTD fragment (00-header)
# already ends with one, so that single blank is the separator. A trailing
# blank line *is* printed at the end of each branch below, to separate the
# block from the "Last login" line / shell prompt that follows.
#
# A small "neve" wordmark in bold cyan so the block announces itself instead
# of blending into the stock system-information panel below it. Quoted heredoc
# so the backticks/quotes in the art need no escaping; colored as a whole.
printf '%s' "$BOLD$CYAN"
cat <<'BANNER'
'OoOo. .oOo. `o   O .oOo.
 o   O OooO'  O   o OooO'
 O   o O      o  O  O
 o   O `OoO'  `o'   `OoO'
BANNER
printf '%s\n' "$RST"
printf 'Neve information as of %s:\n\n' "$NOW"

# --- missing curl: can't probe -----------------------------------------------
if [ -z "$CURL" ]; then
  row "status" "${YEL}unknown${RST}" "port" "$port"
  printf '  (curl not installed — cannot probe /health)\n\n'
  exit 0
fi

body=$("$CURL" -fsS --max-time 2 "$HEALTH_URL" 2>/dev/null)
if [ -z "$body" ]; then
  row "status" "${RED}down${RST}" "port" "$port"
  printf '  systemctl status neve  ·  journalctl -u neve -e\n\n'
  exit 0
fi

# --- no jq: confirm up, but the detail rows need jq to parse /health ---------
if [ -z "$JQ" ]; then
  row "status" "${GRN}up${RST}" "port" "$port"
  printf '  %sjq not available%s — install jq for the full status block\n\n' "$YEL" "$RST"
  exit 0
fi

# --- parse one jq pass into shell-readable fields ----------------------------
# Emits one `H` line of process-wide fields, then one `C` line per chain.
#
# A pre-multi-chain neve has no `chains` map, only the top-level `blocks` /
# `storage`; that case is folded into a single synthetic entry so the render
# path below has exactly one shape to handle.
# shellcheck disable=SC2016  # $id / $b are jq syntax, not shell variables.
parsed=$("$JQ" -r '
  def netname($id): if $id==43114 then "mainnet"
                    elif $id==43113 then "testnet (Fuji)"
                    else "chain " + ($id|tostring) end;
  # Byte count -> "12.3 GiB", matching the human_bytes formatting /health uses.
  # `round`, not `floor`: flooring rendered a 49.7 GiB store as 49.6 and made
  # the summed figure disagree with the one /health prints for a single chain.
  def hb: if . >= 1073741824 then ((. * 10 / 1073741824 | round) / 10 | tostring) + " GiB"
          elif . >= 1048576  then ((. * 10 / 1048576  | round) / 10 | tostring) + " MiB"
          elif . >= 1024     then ((. * 10 / 1024     | round) / 10 | tostring) + " KiB"
          else (tostring) + " B" end;
  # Bail on anything that is not recognizably a /health body. Every field below
  # carries a `//` default, so without this gate a stray JSON document renders a
  # complete, plausible-looking status block instead of saying it cannot parse.
  # `.status` is also the one H field with no default, and an empty @tsv cell
  # would shift the rest of the row left (see the tab-collapse note below).
  if (.status | type) != "string" then empty else . end
  | ( if ((.chains // {}) | length) > 0 then (.chains | to_entries)
    else [{ key: (.default_chain // "c"),
            value: { blocks: (.blocks // {}), storage: (.storage // {}) } }]
    end ) as $cs
  | ( [ $cs[].value.storage.total_bytes // 0 ] | add ) as $bytes
  | [ "H", .status,
      (.uptime // "?"),
      (if $bytes > 0 then ($bytes | hb) else (.storage.total_human // "?") end),
      (.memory.physical_human // "?"),
      (.version // "?"),
      (.commit // "?"),
      (if .chain_id then netname(.chain_id) else "" end)
    ],
    ( $cs[] | .value.blocks as $b
      | [ "C", .key,
          ($b.min_height // "-" | tostring),
          ($b.max_contiguous_height // "-" | tostring),
          ($b.high_water // "-" | tostring),
          ($b.behind // 0 | tostring) ] )
  | @tsv
' <<<"$body" 2>/dev/null)

if [ -z "$parsed" ]; then
  row "status" "${YEL}up${RST}" "port" "$port"
  printf '  (unrecognized /health payload)\n\n'
  exit 0
fi

hdr=''
chain_rows=()
while IFS= read -r line; do
  case "$line" in
    H*) hdr="$line" ;;
    C*) chain_rows+=("$line") ;;
  esac
done <<<"$parsed"

if [ -z "$hdr" ]; then
  row "status" "${YEL}up${RST}" "port" "$port"
  printf '  (unrecognized /health payload)\n\n'
  exit 0
fi

IFS=$'\t' read -r _ status uptime disk rss ver commit network <<<"$hdr"

# The top-level `chain_id` is null when no C-chain is running — a P-chain-only
# box identifies itself by genesis block ID, which is not a number and not
# worth rendering. Fall back to whatever network the unit was configured for:
# `network` in config.toml, then a --network flag in $NEVE_ARGS, which wins.
if [ -z "$network" ]; then
  n=''
  [ -r /etc/neve/config.toml ] &&
    n=$(sed -n 's/^[[:space:]]*network[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
        /etc/neve/config.toml | tail -n1)
  if [ -r /etc/neve/neve.env ]; then
    e=$(sed -n 's/.*--network[ =]\([A-Za-z]*\).*/\1/p' /etc/neve/neve.env | tail -n1)
    [ -n "$e" ] && n="$e"
  fi
  case "$n" in
    mainnet) network="mainnet" ;;
    testnet|fuji) network="testnet (Fuji)" ;;
    '') network="mainnet" ;;                # neve's own default network
    *) network="$n" ;;
  esac
fi

# 25346069 is unreadable at a glance and is exactly the number a deep backfill
# shows for days, so scale it. Integer math only — no fork per chain.
hnum() {
  local n=$1
  if (( n >= 1000000 )); then printf '%d.%dM' $(( n / 1000000 )) $(( n % 1000000 / 100000 ))
  elif (( n >= 1000 )); then printf '%d.%dk' $(( n / 1000 )) $(( n % 1000 / 100 ))
  else printf '%d' "$n"
  fi
}

# `status` from /health is "ok"; surface it as the operator-facing "up".
[ "$status" = "ok" ] && status_word="${GRN}up${RST}" || status_word="${YEL}${status}${RST}"

row "status"    "$status_word" "port"    "$port"
row "uptime"    "$uptime"      "network" "$network"
row "used disk" "$disk"        "memory"  "$rss"

# One row per chain, so a caught-up C-chain can never speak for a backfilling
# P-chain. Blank separator only when there is something to separate.
[ ${#chain_rows[@]} -gt 0 ] && printf '\n'
for line in "${chain_rows[@]}"; do
  # Tab is IFS *whitespace*, so `read` collapses a run of them and empty fields
  # would shift every later value left — a null min_height silently landed
  # `behind` in `min`. The jq above emits "-" rather than "" for exactly this.
  IFS=$'\t' read -r _ ch min mc hw behind <<<"$line"

  if [ "${behind:-0}" -eq 0 ] 2>/dev/null; then
    sync="${GRN}caught up${RST}"
  else
    sync="${YEL}$(hnum "$behind") behind${RST}"
  fi

  # min_height is null until first ingest — a store that exists but holds
  # nothing yet, which is what a just-enabled second chain looks like.
  if [ "$min" = "-" ]; then
    range="${YEL}empty${RST}"
  elif [ "$hw" != "$mc" ]; then
    # high_water can run ahead of the contiguous height if newHeads raced backfill.
    range="${min}–${mc} (hw ${hw})"
  else
    range="${min}–${mc}"
  fi

  # "c" -> "C-chain"; works for any chain letter neve grows later.
  row "${ch^^}-chain" "$sync" "blocks" "$range"
done
printf '\n  version: v%s (%s)\n  health:  http://%s/health\n  metrics: http://%s/metrics\n  logs:    journalctl -u neve -f\n  updater: sudo /opt/neve/deploy/update.sh\n\n' \
  "$ver" "$commit" "$port" "$port"
