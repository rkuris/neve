# Based on https://www.toptal.com/developers/gitignore/api/vim,rust,visualstudiocode
# with two deliberate deviations, noted inline below. Regenerate with that URL,
# then re-apply them.

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# NOTE: the upstream template ignores Cargo.lock here. neve is a *binary* crate
# whose lockfile is committed and load-bearing — deploy/update.sh builds with
# `cargo build --release --locked`, and reproducing a deploy depends on it. The
# template says as much: "Remove Cargo.lock from gitignore if creating an
# executable". So it is deliberately absent.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

### Vim ###
# Swap
[._]*.s[a-v][a-z]
# NOTE: the template has `!*.svg  # comment out if you don't need vector files`
# here. In gitignore syntax `#` only starts a comment at the beginning of a line,
# so the trailing text is part of the pattern and the rule negates nothing. The
# negation is unnecessary anyway: the swap pattern above requires a leading `.`
# or `_`, so assets/neve-logo.svg was never matched. Dropped rather than repaired.
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
# Auto-generated tag files
tags
# Persistent undo
[._]*.un~

### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

### neve ###
# Block stores. Unanchored and unsuffixed so it covers the default
# ./blockstore-data-<network> as well as any ad-hoc store built alongside it.
blockstore-data*

# bulk-export output (GET /blocks)
*.ndjson
